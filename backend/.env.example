# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to git — add it to .gitignore.

# SQLite file for local dev (Prisma creates this file automatically)
DATABASE_URL="file:./dev.db"

# Any long random string — used to sign login tokens.
# Generate one quickly with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="d354ff185224b126c01debb902faaff410d4718f1db719f6e3df18aff80bfbfc"

# Port the backend server runs on
PORT=4000

# The URL your frontend runs on, for CORS
FRONTEND_ORIGIN="http://127.0.0.1:5500"
